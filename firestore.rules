rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isDirectoryIdentity(userId) {
      return isValidId(userId) && (request.auth == null || request.auth.uid == userId || isValidId(request.auth.uid));
    }

    // 3. Entity Validation Blueprints
    function isValidUserPublicProfile(data, userId) {
      return data.keys().hasAll(['uid', 'username', 'displayName', 'isOnline', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'appUserId', 'username', 'displayName', 'avatarUrl', 'bio', 'isOnline', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == userId
        && (!('appUserId' in data) || (data.appUserId is string && data.appUserId.size() >= 1 && data.appUserId.size() <= 128 && isValidId(data.appUserId)))
        && data.username is string && data.username.size() >= 2 && data.username.size() <= 32 && data.username.matches('^[a-zA-Z0-9_]+$')
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 64
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 2048))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 256))
        && data.isOnline is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'phone', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == userId && data.uid == request.auth.uid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 128
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 32))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCloudNote(data, userId) {
      return data.keys().hasAll(['ownerId', 'content', 'isPinned', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'content', 'tag', 'isPinned', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId == userId
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 4000
        && (!('tag' in data) || (data.tag is string && data.tag.size() <= 32))
        && data.isPinned is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCloudConversation(data, userId, conversationId) {
      return data.keys().hasAll(['ownerId', 'convId', 'type', 'name', 'memberIds', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'convId', 'type', 'name', 'description', 'avatarUrl', 'lastMessageText', 'memberIds', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId == userId
        && data.convId is string && data.convId == conversationId && isValidId(data.convId)
        && (data.type == 'direct' || data.type == 'group')
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 128
        && (!('description' in data) || (data.description is string && data.description.size() <= 512))
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 2048))
        && (!('lastMessageText' in data) || (data.lastMessageText is string && data.lastMessageText.size() <= 1000))
        && data.memberIds is list && data.memberIds.size() <= 50
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCloudMessage(data, userId, messageId) {
      return data.keys().hasAll(['ownerId', 'msgId', 'conversationId', 'senderId', 'senderName', 'content', 'type', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'msgId', 'conversationId', 'senderId', 'senderName', 'content', 'type', 'mediaUrl', 'fileName', 'status', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId == userId
        && data.msgId is string && data.msgId == messageId && isValidId(data.msgId)
        && data.conversationId is string && isValidId(data.conversationId)
        && data.senderId is string && isValidId(data.senderId)
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 64
        && data.content is string && data.content.size() <= 4000
        && data.type is string && data.type.size() >= 1 && data.type.size() <= 32
        && (!('mediaUrl' in data) || (data.mediaUrl is string && data.mediaUrl.size() <= 200000))
        && (!('fileName' in data) || (data.fileName is string && data.fileName.size() <= 256))
        && (data.status == 'sending' || data.status == 'sent' || data.status == 'delivered' || data.status == 'read')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCloudFile(data, userId, fileId) {
      return data.keys().hasAll(['ownerId', 'fileId', 'fileName', 'mimeType', 'sizeBytes', 'dataUrl', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'fileId', 'fileName', 'mimeType', 'sizeBytes', 'dataUrl', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId == userId
        && data.fileId is string && data.fileId == fileId && isValidId(data.fileId)
        && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 256
        && data.mimeType is string && data.mimeType.size() >= 1 && data.mimeType.size() <= 128
        && data.sizeBytes is int && data.sizeBytes >= 0 && data.sizeBytes <= 5000000
        && data.dataUrl is string && data.dataUrl.size() >= 1 && data.dataUrl.size() <= 750000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCloudStory(data, storyId) {
      return data.keys().hasAll(['authorUid', 'storyId', 'authorId', 'authorName', 'type', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['authorUid', 'storyId', 'authorId', 'authorName', 'authorAvatar', 'type', 'text', 'mediaUrl', 'background', 'createdAt', 'updatedAt'])
        && data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 && isValidId(data.authorUid)
        && data.storyId is string && data.storyId == storyId && isValidId(data.storyId)
        && data.authorId is string && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 64
        && (!('authorAvatar' in data) || (data.authorAvatar is string && data.authorAvatar.size() <= 2048))
        && (data.type == 'text' || data.type == 'image')
        && (!('text' in data) || (data.text is string && data.text.size() <= 1000))
        && (!('mediaUrl' in data) || (data.mediaUrl is string && data.mediaUrl.size() <= 200000))
        && (!('background' in data) || (data.background is string && data.background.size() <= 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 4. Collection Rules
    match /users/{userId} {
      allow get: if isDirectoryIdentity(userId) && (resource == null || existing().uid == userId);
      allow list: if request.query.limit <= 100;

      allow create: if isDirectoryIdentity(userId)
        && isValidUserPublicProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isDirectoryIdentity(userId)
        && isValidUserPublicProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['appUserId', 'username', 'displayName', 'avatarUrl', 'bio', 'isOnline', 'updatedAt']);

      allow delete: if false;

      match /private/{docId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(docId) && (resource == null || existing().uid == request.auth.uid);
        allow list: if false;

        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(docId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(docId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phone', 'updatedAt'])
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow delete: if false;
      }

      match /notes/{noteId} {
        allow get: if isDirectoryIdentity(userId) && isValidId(noteId) && (resource == null || existing().ownerId == userId);
        allow list: if isDirectoryIdentity(userId) && request.query.limit <= 200;

        allow create: if isDirectoryIdentity(userId)
          && isValidId(noteId)
          && isValidCloudNote(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == userId;

        allow update: if isDirectoryIdentity(userId)
          && isValidId(noteId)
          && isValidCloudNote(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['content', 'tag', 'isPinned', 'updatedAt'])
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == userId;

        allow delete: if isDirectoryIdentity(userId)
          && isValidId(noteId)
          && existing().ownerId == userId;
      }

      match /conversations/{conversationId} {
        allow get: if isDirectoryIdentity(userId) && isValidId(conversationId) && (resource == null || existing().ownerId == userId);
        allow list: if isDirectoryIdentity(userId) && request.query.limit <= 200;

        allow create: if isDirectoryIdentity(userId)
          && isValidId(conversationId)
          && isValidCloudConversation(incoming(), userId, conversationId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == userId;

        allow update: if isDirectoryIdentity(userId)
          && isValidId(conversationId)
          && isValidCloudConversation(incoming(), userId, conversationId)
          && incoming().ownerId == existing().ownerId
          && incoming().convId == existing().convId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'avatarUrl', 'lastMessageText', 'memberIds', 'updatedAt'])
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == userId;

        allow delete: if isDirectoryIdentity(userId)
          && isValidId(conversationId)
          && existing().ownerId == userId;
      }

      match /messages/{messageId} {
        allow get: if isDirectoryIdentity(userId) && isValidId(messageId) && (resource == null || existing().ownerId == userId);
        allow list: if isDirectoryIdentity(userId) && request.query.limit <= 250;

        allow create: if isDirectoryIdentity(userId)
          && isValidId(messageId)
          && isValidCloudMessage(incoming(), userId, messageId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == userId;

        allow update: if isDirectoryIdentity(userId)
          && isValidId(messageId)
          && isValidCloudMessage(incoming(), userId, messageId)
          && incoming().ownerId == existing().ownerId
          && incoming().msgId == existing().msgId
          && incoming().conversationId == existing().conversationId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['content', 'status', 'updatedAt'])
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == userId;

        allow delete: if isDirectoryIdentity(userId)
          && isValidId(messageId)
          && existing().ownerId == userId;
      }

      match /files/{fileId} {
        allow get: if isDirectoryIdentity(userId) && isValidId(fileId) && (resource == null || existing().ownerId == userId);
        allow list: if isDirectoryIdentity(userId) && request.query.limit <= 200;

        allow create: if isDirectoryIdentity(userId)
          && isValidId(fileId)
          && isValidCloudFile(incoming(), userId, fileId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == userId;

        allow update: if isDirectoryIdentity(userId)
          && isValidId(fileId)
          && isValidCloudFile(incoming(), userId, fileId)
          && incoming().ownerId == existing().ownerId
          && incoming().fileId == existing().fileId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['fileName', 'updatedAt'])
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == userId;

        allow delete: if isDirectoryIdentity(userId)
          && isValidId(fileId)
          && existing().ownerId == userId;
      }
    }

    match /stories/{storyId} {
      allow get: if isValidId(storyId) && (resource == null || existing().storyId == storyId);
      allow list: if request.query.limit <= 100;

      allow create: if isValidId(storyId)
        && isValidCloudStory(incoming(), storyId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(storyId)
        && isValidCloudStory(incoming(), storyId)
        && incoming().authorUid == existing().authorUid
        && incoming().storyId == existing().storyId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['text', 'mediaUrl', 'background', 'updatedAt']);

      allow delete: if isValidId(storyId)
        && isValidId(existing().authorUid);
    }
  }
}
