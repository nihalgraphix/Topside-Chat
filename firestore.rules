rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 3. Entity Validation Blueprints
    function isValidUserPublicProfile(data, userId) {
      return data.keys().hasAll(['uid', 'username', 'displayName', 'isOnline', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'username', 'displayName', 'avatarUrl', 'bio', 'isOnline', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == userId && data.uid == request.auth.uid
        && data.username is string && data.username.size() >= 2 && data.username.size() <= 32 && data.username.matches('^[a-zA-Z0-9_]+$')
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 64
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 1024))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 256))
        && data.isOnline is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'phone', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == userId && data.uid == request.auth.uid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 128
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 32))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCloudNote(data, userId) {
      return data.keys().hasAll(['ownerId', 'content', 'isPinned', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'content', 'tag', 'isPinned', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId == userId && data.ownerId == request.auth.uid
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 4000
        && (!('tag' in data) || (data.tag is string && data.tag.size() <= 32))
        && data.isPinned is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 4. Collection Rules
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && existing().uid == userId;
      allow list: if isSignedIn() && existing().uid == request.auth.uid;

      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserPublicProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserPublicProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['username', 'displayName', 'avatarUrl', 'bio', 'isOnline', 'updatedAt']);

      allow delete: if false;

      match /private/{docId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(docId) && existing().uid == request.auth.uid;
        allow list: if false;

        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(docId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(docId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phone', 'updatedAt'])
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow delete: if false;
      }

      match /notes/{noteId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(noteId) && existing().ownerId == request.auth.uid;
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;

        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(noteId)
          && isValidCloudNote(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(noteId)
          && isValidCloudNote(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['content', 'tag', 'isPinned', 'updatedAt'])
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow delete: if isOwner(userId)
          && isValidId(userId)
          && isValidId(noteId)
          && existing().ownerId == request.auth.uid;
      }
    }
  }
}
